site_pair() {
    agent=$1
    label=$2
    (
        cd "$site_source"
        FORUM_AGENT=$agent \
            XDG_CONFIG_HOME=$site_config \
            TINY_FIXTURE_LOOM=$real_runner \
            TINY_LOOM_WORKTREE_ROOT=$site_source \
            TINY_BUILD_RESOURCE_LOCK_DIR=$site_root/resources \
            TINY_BUILD_RESOURCE_CPU_COUNT=16 \
            TINY_BUILD_RESOURCE_TOTAL_MIB=65536 \
            "$real_runner" run heavy --site "$site_name" -- sh -c 'sleep 0.2'
    ) >"$site_root/$label-one.out" 2>"$site_root/$label-one.err" &
    first_pid=$!
    PIDS="$PIDS $first_pid"
    (
        cd "$site_source"
        FORUM_AGENT=$agent \
            XDG_CONFIG_HOME=$site_config \
            TINY_FIXTURE_LOOM=$real_runner \
            TINY_LOOM_WORKTREE_ROOT=$site_source \
            TINY_BUILD_RESOURCE_LOCK_DIR=$site_root/resources \
            TINY_BUILD_RESOURCE_CPU_COUNT=16 \
            TINY_BUILD_RESOURCE_TOTAL_MIB=65536 \
            "$real_runner" run heavy --site "$site_name" -- sh -c 'sleep 0.2'
    ) >"$site_root/$label-two.out" 2>"$site_root/$label-two.err" &
    second_pid=$!
    PIDS="$PIDS $second_pid"
    set +e
    wait "$first_pid"
    first_status=$?
    wait "$second_pid"
    second_status=$?
    set -e
    PIDS=
    if [ "$first_status" -ne 0 ] || [ "$second_status" -ne 0 ]; then
        sed -n '1,80p' "$site_root/$label-one.err" >&2
        sed -n '1,80p' "$site_root/$label-two.err" >&2
        fail "site pair failed with statuses $first_status and $second_status"
    fi
}

site_receipts() {
    agent=$1
    output=$2
    (
        cd "$site_source"
        XDG_CONFIG_HOME=$site_config \
            TINY_LOOM_WORKTREE_ROOT=$site_source \
            "$real_runner" ledger --agent "$agent" --json
    ) >"$output"
}

