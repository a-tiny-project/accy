    exec "$BOOTSTRAP_HELPER" run --resolve \
        --root "$ROOT" --zig "$BOOTSTRAP_ZIG" \
        --snapshot "$BOOTSTRAP_SNAPSHOT" \
        --source "$BOOTSTRAP_SOURCE_ID" \
        --worktree "$BOOTSTRAP_WORKTREE_ID" -- "$@"
fi
